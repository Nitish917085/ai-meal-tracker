# Base URL of the backend API. Leave empty to use the Vite dev proxy at /api.
# When deploying the frontend separately, set this to the full API origin, e.g.
# VITE_API_URL=http://localhost:4000/api
VITE_API_URL=

# Base URL of the standalone AI service (vision/text extraction + chat).
VITE_AI_URL=http://localhost:4001
