# Server
PORT=4001
NODE_ENV=development

# Directory where uploaded images are saved (top-level /uploads by default)
UPLOADS_DIR=uploads

# The main calorie service (for chat tool data operations)
CALORIE_SERVICE_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────────────────────
# LLM / AI configuration (OpenAI-compatible API)
#
# Provider presets — set AI_PROVIDER to switch. Default is `openrouter`.
#   AI_PROVIDER=openrouter  → OpenRouter (one key, many models incl. free ones)
#   AI_PROVIDER=openai      → OpenAI direct
#   AI_PROVIDER=custom      → use your own AI_BASE_URL / models
#
# Only models from these vendors are used: Google, Anthropic (Claude),
# Amazon (Nova), Meta (Llama), OpenAI (GPT) and xAI (Grok).
#
# Each value below can also be overridden individually:
#   AI_API_KEY        (alias: OPENAI_API_KEY)
#   AI_BASE_URL       (alias: OPENAI_BASE_URL)
#   AI_CHAT_MODEL     (alias: OPENAI_MODEL)
#   AI_VISION_MODEL   (alias: OPENAI_VISION_MODEL)
#
# Defaults for `openrouter`:
#   chat   = google/gemini-2.0-flash-exp:free         (Google Gemini)
#   vision = google/gemini-2.0-flash-exp:free         (multimodal image extraction)
# ─────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=openrouter
# Restrict to US vendors (Google, Anthropic, Amazon, Meta, OpenAI, xAI).
# Set to false to allow any model the provider offers.
ONLY_USA=true
OPENAI_API_KEY=
# OPENROUTER_REFERER=  # optional, e.g. https://your-app.com (attribution/ranking)
# OPENROUTER_TITLE=CaloriePal
