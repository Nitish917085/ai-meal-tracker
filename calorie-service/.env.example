# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL — local Docker, Supabase, or any managed Postgres)
#
# Local dev (docker compose up -d):
#   postgres://postgres:postgres@localhost:5432/calorie_tracker
#
# Supabase (hosted) — copy from Supabase Dashboard → Project Settings → Database:
#   Transaction pooler (recommended for the app, port 6543):
#     postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
#   Session pooler (port 5432) or direct connection also work.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/calorie_tracker
DB_POOL_MAX=10
# SSL is auto-enabled for Supabase URLs. Set explicitly for other managed hosts.
DATABASE_SSL=false

# Authentication
JWT_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Supabase JS client (Auth, Realtime, Storage) — optional, leave empty if unused.
# Copy from Supabase Dashboard → Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Standalone AI service (server-to-server calls from this service's logic).
AI_SERVICE_URL=http://localhost:4001

# Password-reset OTP email (Gmail app password). Only used when BYPASS_FULL_AUTH=false.
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# When true, password-reset skips OTP email verification (development only).
BYPASS_FULL_AUTH=false